{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account profile and role information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["EMPLOYEE", "ADMIN"] },
        "department": { "type": "string", "maxLength": 100 },
        "jobTitle": { "type": "string", "maxLength": 100 },
        "employeeCode": { "type": "string", "maxLength": 50 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "name", "role"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily employee attendance record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string", "maxLength": 10 },
        "checkInTime": { "type": "string" },
        "checkOutTime": { "type": "string" },
        "status": { "type": "string", "enum": ["PRESENT", "CHECKED_IN", "INCOMPLETE_CHECKOUT", "ABSENT", "PAID_LEAVE", "UNPAID_LEAVE", "WEEKEND_OFF", "SUNDAY_WORKED"] },
        "hoursWorked": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "date", "status"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin privilege marker document",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/admins/{userId}": {
      "schema": "Admin",
      "description": "Admin role markers"
    },
    "/attendance_records/{recordId}": {
      "schema": "AttendanceRecord",
      "description": "Attendance records collection"
    }
  }
}
